{
  "name": "smart-dust-collector",
  "private": true,
  "version": "0.1.0",
  "description": "Fork-local smart dust collector: ESPHome firmware, TS control FSM, HF audio prototype",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:hf": "vite --config hf-prototype/vite.config.ts",
    "build:hf": "vite build --config hf-prototype/vite.config.ts",
    "preview:hf": "vite preview --config hf-prototype/vite.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
